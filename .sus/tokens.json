{
  "$schema": "https://design-tokens.org/schema.json (DTCG community report 2025.10; not a W3C Recommendation — citation stays honest)",
  "color": {
    "surface": {
      "base": { "$type": "color", "$value": "#ffffff" },
      "raised": { "$type": "color", "$value": "#f4f6fa" }
    },
    "fg": {
      "default": { "$type": "color", "$value": "#1a1d21" },
      "muted": { "$type": "color", "$value": "#5c6470" }
    },
    "accent": {
      "default": { "$type": "color", "$value": "#2743c7" },
      "on": { "$type": "color", "$value": "#ffffff" }
    },
    "line": { "default": { "$type": "color", "$value": "#dfe3ea" } }
  },
  "space": {
    "group": { "$type": "dimension", "$value": "1rem" },
    "section": { "$type": "dimension", "$value": "3rem" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "10px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "240ms" }
    },
    "easing": { "standard": { "$type": "cubic-bezier", "$value": "[0.2, 0, 0, 1]" } }
  },
  "typography": {
    "size": {
      "body": { "$type": "dimension", "$value": "1rem" },
      "h1": { "$type": "dimension", "$value": "2.25rem" }
    },
    "lineHeight": { "body": { "$type": "number", "$value": 1.6 } }
  }
}
