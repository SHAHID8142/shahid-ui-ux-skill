{
  "name": "sus",
  "version": "0.0.0",
  "private": true,
  "description": "SUS — Shahid UI UX Skill monorepo (ADR-001 layout). Private; not published.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm run --silent build && pnpm -r --if-present run typecheck",
    "check": "node scripts/check-continuation.mjs && node scripts/check-gates.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"**/*.css\"",
    "build": "pnpm -r --if-present run build",
    "gates": "node scripts/check-gates.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.0"
  }
}
