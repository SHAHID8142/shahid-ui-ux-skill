{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "scores": {
      "minItems": 12,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "axis": {
            "type": "string",
            "enum": [
              "hierarchy",
              "composition",
              "typography",
              "color-surface",
              "spacing-rhythm",
              "motion-interaction",
              "content-copy",
              "accessibility",
              "responsive-edge",
              "consistency-system",
              "distinctiveness-pov",
              "performance"
            ]
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "basis": {
            "type": "string",
            "enum": [
              "measured",
              "critic-validated",
              "judged"
            ]
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "anchorsNote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "axis",
          "score",
          "basis",
          "evidence",
          "anchorsNote"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "subject",
    "scores"
  ],
  "additionalProperties": false,
  "$id": "sus.rubric-score",
  "x-sus-version": 1
}
